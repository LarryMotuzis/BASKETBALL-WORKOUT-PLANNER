generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  position  String?
  createdAt DateTime @default(now())

  workouts Workout[]
}

model Workout {
  id          String   @id @default(cuid())
  title       String
  focus       String
  workoutDate DateTime
  notes       String?

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  createdAt DateTime @default(now())
}

model Drill {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  createdAt   DateTime @default(now())
}