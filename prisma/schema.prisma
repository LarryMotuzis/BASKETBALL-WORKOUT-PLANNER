generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  position  String?
  createdAt DateTime @default(now())

  workoutPlayers WorkoutPlayer[]
}

model Workout {
  id          String   @id @default(cuid())
  title       String
  focus       String
  workoutDate DateTime
  notes       String?

  workoutPlayers WorkoutPlayer[]

  workoutDrills WorkoutDrill[]

  createdAt DateTime @default(now())
}

model Drill {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  createdAt   DateTime @default(now())

  workoutDrills WorkoutDrill[]
}

model WorkoutDrill {
  id String @id @default(cuid())

  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id])

  drillId String
  drill   Drill  @relation(fields: [drillId], references: [id])

  order Int
  notes String?

  createdAt DateTime @default(now())
}

model WorkoutPlayer {
  id String @id @default(cuid())

  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id])

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  createdAt DateTime @default(now())
}
